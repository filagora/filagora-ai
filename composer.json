{
    "name": "filagora/filagora-ai",
    "description": "AI chat, usage records and provider plumbing for Filagora applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "ai"
    ],
    "require": {
        "php": "^8.4",
        "filagora/filagora-core": "^0.2.2",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "filagora/filagora-entitlements": "^0.2.1",
        "filagora/filagora-search": "^0.2.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\Ai\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\Ai\\AiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "suggest": {
        "filagora/filagora-entitlements": "Answers the access check from entitlement grants. Without it, bind Filagora\\Core\\Contracts\\AccessChecker.",
        "filagora/filagora-search": "Lets the AI features index their content for search by meaning, and fills those indexes with VectorBackfill."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
